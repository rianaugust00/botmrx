# ---------- Resumo (Claude) ----------
# Chave da API Anthropic (console.anthropic.com). Alternativa: `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# low | medium | high — medium costuma bastar para extração; teste low para reduzir custo/latência
LLM_EFFORT=medium
# Fallback automático do servidor se o modelo recusar. "off" para desligar
# (desligue se trocar para um modelo sem suporte, ex.: Haiku).
LLM_FALLBACK=default

# ---------- Transcrição (endpoint no formato OpenAI /audio/transcriptions) ----------
# Nuvem:  https://api.openai.com/v1   (ou outro provedor compatível)
# Local:  http://localhost:8000/v1    (servidor Whisper self-hosted com API compatível)
TRANSCRICAO_URL=https://api.openai.com/v1
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=whisper-1
TRANSCRICAO_CONCORRENCIA=4
# Nomes de sistemas, siglas e pessoas do time — ajuda o Whisper a escrever certo
TRANSCRICAO_VOCABULARIO=Daily do time. Termos: Pix, webhook, homologação, Cypress, Jira, Confluence, pull request, deploy.

# ---------- Geral ----------
TIME_NOME=
FUSO_HORARIO=America/Sao_Paulo
# Junta trechos seguidos da mesma pessoa com intervalo menor que isso (ms)
JUNTAR_FALAS_ATE_MS=1500
