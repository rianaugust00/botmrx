# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Onde salvar as gravações
PASTA_GRAVACOES=./gravacoes

# Silêncio (ms) que fecha um trecho de fala
SILENCIO_MS=1000

# Trechos com menos áudio que isso (ms) são descartados ("ok", "sim", ruído)
MIN_SEGMENTO_MS=600

# Encerra sozinho depois de N minutos
DURACAO_MAXIMA_MIN=60

# IDs de usuários do Discord que NÃO devem ser gravados, separados por vírgula
NAO_GRAVAR=

# 1 = logs detalhados da conexão de voz (útil se não conectar ou se o DAVE falhar)
DEBUG_VOZ=0
