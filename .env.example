# ---------- Discord ----------
# Token do bot (Discord Developer Portal → Bot → Reset Token). Usado pelo bot e pelo worker
# (o worker só posta o resumo no canal de texto).
DISCORD_BOT_TOKEN=
# Login do dashboard (opcional). Com os dois preenchidos, o dashboard exige "Entrar com Discord".
#   Client ID:     Developer Portal → sua aplicação → OAuth2 → Client ID (é o Application ID)
#   Client Secret: mesma tela → Reset Secret
#   Na mesma tela, em Redirects, cadastre:  <PAINEL_URL>/api/auth/retorno
#   (padrão: http://127.0.0.1:3000/api/auth/retorno)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 1 = logs detalhados da conexão de voz (útil se não conectar ou se o DAVE falhar)
DEBUG_VOZ=0

# ---------- Dados locais ----------
SQLITE_PATH=dados/botmrx.db
AUDIO_STORAGE_PATH=dados/audio

# ---------- Captura ----------
# Silêncio (ms) que fecha um trecho de fala
SEGMENTO_SILENCIO_MS=1000
# Trechos com menos áudio que isso (ms) são descartados ("ok", "sim", ruído)
SEGMENTO_MINIMO_MS=600
# Encerra sozinha depois de N minutos
DAILY_DURACAO_MAXIMA_MIN=60

# ---------- Transcrição (endpoint no formato OpenAI /audio/transcriptions) ----------
# Nuvem:  https://api.openai.com/v1   (ou outro provedor compatível)
# Local:  http://localhost:8000/v1    (servidor Whisper self-hosted com API compatível)
TRANSCRICAO_URL=https://api.openai.com/v1
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=whisper-1
TRANSCRICAO_CONCORRENCIA=4
# Nomes de sistemas, siglas e pessoas do time — ajuda o Whisper a escrever certo
TRANSCRICAO_VOCABULARIO=
# Junta trechos seguidos da mesma pessoa com intervalo menor que isso (ms)
JUNTAR_FALAS_ATE_MS=1500

# ---------- Resumo (LLM) ----------
# anthropic = API do Claude (paga; é a referência da arquitetura)
# openai    = qualquer API no formato OpenAI /chat/completions: Groq, Gemini, OpenRouter, Ollama local...
LLM_PROVEDOR=anthropic

# -- se LLM_PROVEDOR=anthropic --
# Chave da API Anthropic (console.anthropic.com). Alternativa: `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# low | medium | high — medium costuma bastar para extração
LLM_EFFORT=medium
# Fallback automático do servidor se o modelo recusar. "off" para desligar
# (desligue se trocar para um modelo sem suporte, ex.: Haiku).
LLM_FALLBACK=default

# -- se LLM_PROVEDOR=openai (exemplo: Groq, que tem plano gratuito) --
# LLM_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODELO=llama-3.3-70b-versatile
# No Groq a mesma chave serve para a transcrição:
# TRANSCRICAO_URL=https://api.groq.com/openai/v1
# TRANSCRICAO_MODELO=whisper-large-v3
# Rode `npm run verificar` para conferir a chave e os nomes dos modelos.

# ---------- Worker ----------
JOB_MAX_TENTATIVAS=5
JOB_RESERVA_MIN=10
# "off" para não postar o resumo no canal de texto
POSTAR_RESUMO=on

# ---------- Dashboard (API + tela) ----------
API_PORT=3000
# 127.0.0.1 = só esta máquina. Para abrir na rede (0.0.0.0) o login precisa estar configurado.
API_HOST=127.0.0.1
# Endereço pelo qual as pessoas abrem o dashboard (define o retorno do login). Sem barra no fim.
# PAINEL_URL=http://127.0.0.1:3000
PAINEL_SESSAO_DIAS=7
# Teto de transcrição enviada ao LLM por pergunta livre (acima disso, só as dailies mais recentes)
PERGUNTAS_MAX_CARACTERES=40000

# ---------- Retenção (LGPD) ----------
# Transcrições são apagadas depois deste prazo (o resumo fica)
RETENCAO_TRANSCRICAO_DIAS=180
# Áudio de dailies que pararam com erro é guardado só por este prazo
AUDIO_RETENCAO_ERRO_DIAS=7
