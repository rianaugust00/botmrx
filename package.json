{
  "name": "botmrx",
  "version": "0.1.0",
  "description": "Bot que grava as dailies do Discord, transcreve e gera um resumo por pessoa",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning ferramentas/iniciar.js",
    "bot": "node --disable-warning=ExperimentalWarning bot/index.js",
    "worker": "node --disable-warning=ExperimentalWarning worker/index.js",
    "painel": "node --disable-warning=ExperimentalWarning api/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "importar": "node --disable-warning=ExperimentalWarning ferramentas/importar.js",
    "ver": "node --disable-warning=ExperimentalWarning ferramentas/ver.js",
    "reprocessar": "node --disable-warning=ExperimentalWarning ferramentas/reprocessar.js",
    "verificar": "node --disable-warning=ExperimentalWarning ferramentas/verificar.js",
    "demo": "node --disable-warning=ExperimentalWarning ferramentas/demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "prism-media": "^1.3.5"
  },
  "engines": {
    "node": ">=22.13"
  }
